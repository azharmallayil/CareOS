# ==============================================================================
# CareOS Cloud Stack (API + Worker) — OCI Environment Variables Template
# Copy this file to .env and fill in your Supabase credentials:
#   cp .env.example .env
# ==============================================================================

# ── General Server Settings ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── Supabase Cloud Credentials (Singapore Project: vbckrirksziluvwqpamx) ────
SUPABASE_URL=https://vbckrirksziluvwqpamx.supabase.co
# Replace with your Supabase Anon (Publishable) Key:
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZiY2tyaXJrc3ppbHV2d3FwYW14Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ2Njg5OTcsImV4cCI6MjExMDI0NDk5N30.76jizSAIaVw3MXHAY87fNOfsUO3Ev6BTE4I5jRmFQIM
# Replace with your Supabase Service Role Key (Keep Private - Never expose to browser):
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Replace with your Supabase JWT Secret (from Supabase Dashboard -> Project Settings -> API):
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ── Cryptographic Secrets ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
COOKIE_SECRET=change_me_to_a_32_character_random_hex_secret_here
JWT_SECRET=change_me_to_a_32_character_random_hex_secret_here

# ── Allowed CORS Origins ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend domains
CORS_ORIGINS=https://relaxed-dodgerblue-newt-58.hostingersite.com,http://localhost:5173

# ── Background Worker Tuning ──────────────────────────────────────────────────
POLL_INTERVAL_MS=3000
LEASE_DURATION_SECONDS=60
WORKER_CONCURRENCY=3
